+name: CI/CD
+
+# Testes + compatibilidade a cada push/PR; deploy automático só no master,
+# e apenas depois que todos os jobs de teste passarem.
+on:
+  push:
+    branches: [master, main]
+  pull_request:
+    branches: [master, main]
+  workflow_dispatch:
+
+# Cancela execuções antigas do mesmo ref (economiza runner).
+# Em push (master) NÃO cancela, para não interromper um deploy em andamento.
+concurrency:
+  group: ci-${{ github.ref }}
+  cancel-in-progress: ${{ github.event_name == 'pull_request' }}
+
+permissions:
+  contents: read
+
+jobs:
+  # ---------------------------------------------------------------------------
+  # 1) Backend: testes reais contra PostgreSQL (os fixtures dão skip sem banco).
+  #    Matriz de Python detecta incompatibilidade de dependências por versão.
+  #    `pip check` falha se uma lib nova conflitar com as já instaladas.
+  # ---------------------------------------------------------------------------
+  backend:
+    name: Backend · Python ${{ matrix.python }}
+    runs-on: ubuntu-latest
+    strategy:
+      fail-fast: false
+      matrix:
+        python: ["3.11", "3.12"]
+
+    services:
+      postgres:
+        image: postgres:16-alpine
+        env:
+          POSTGRES_DB: granaai_test
+          POSTGRES_USER: granaai
+          POSTGRES_PASSWORD: secret
+        ports:
+          - 5432:5432
+        options: >-
+          --health-cmd "pg_isready -U granaai"
+          --health-interval 5s
+          --health-timeout 5s
+          --health-retries 10
+
+    env:
+      # Settings do app exige estas variáveis; valores fictícios bastam.
+      DATABASE_URL: postgresql+asyncpg://granaai:secret@localhost:5432/granaai
+      TEST_DATABASE_URL: postgresql+asyncpg://granaai:secret@localhost:5432/granaai_test
+      GROQ_API_KEY: ci-dummy
+      GROQ_CHAT_MODEL: qwen/qwen3.8-27b
+      GROQ_WHISPER_MODEL: whisper-large-v3
+      GROQ_VISION_MODEL: qwen/qwen3.8-27b
+      EVOLUTION_API_KEY: ci-dummy
+      EVOLUTION_API_URL: http://localhost:8081
+      EVOLUTION_INSTANCE: granaai
+      WHATSAPP_WEBHOOK_SECRET: ci-dummy
+      WHATSAPP_ALLOWED_PHONE: "5527998693240"
+      FRONTEND_URL: http://localhost:5173
+      CORS_ORIGINS: '["http://localhost:5173"]'
+
+    steps:
+      - uses: actions/checkout@v4
+
+      - uses: actions/setup-python@v5
+        with:
+          python-version: ${{ matrix.python }}
+          cache: pip
+          cache-dependency-path: backend/requirements.txt
+
+      - name: Instalar dependências
+        working-directory: backend
+        run: pip install -r requirements.txt
+
+      - name: Checar conflitos de dependências (pip check)
+        working-directory: backend
+        run: pip check
+
+      - name: Rodar testes
+        working-directory: backend
+        run: pytest -v
+
+  # ---------------------------------------------------------------------------
+  # 2) Frontend: lockfile consistente + árvore de deps válida + tipos + build.
+  #    `npm ci` falha se o package-lock divergir do package.json (lib nova sem
+  #    lock atualizado); `npm ls` falha com deps ausentes/ inválidas.
+  # ---------------------------------------------------------------------------
+  frontend:
+    name: Frontend · Node ${{ matrix.node }}
+    runs-on: ubuntu-latest
+    strategy:
+      fail-fast: false
+      matrix:
+        node: ["20", "22"]
+
+    steps:
+      - uses: actions/checkout@v4
+
+      - uses: actions/setup-node@v4
+        with:
+          node-version: ${{ matrix.node }}
+          cache: npm
+          cache-dependency-path: frontend/package-lock.json
+
+      - name: Instalar dependências (npm ci)
+        working-directory: frontend
+        run: npm ci
+
+      - name: Checar árvore de dependências (npm ls)
+        working-directory: frontend
+        run: npm ls --depth=0
+
+      - name: Tipos + build de produção
+        working-directory: frontend
+        run: npm run build
+
+  # ---------------------------------------------------------------------------
+  # 3) Docker + smoke test: as imagens reais constroem e o compose sobe de fato,
+  #    respondendo no /health (API e via proxy do nginx do frontend).
+  # ---------------------------------------------------------------------------
+  docker:
+    name: Docker · build + smoke
+    runs-on: ubuntu-latest
+    env:
+      GROQ_CHAT_MODEL: qwen/qwen3.8-27b
+    steps:
+      - uses: actions/checkout@v4
+
+      - name: Build das imagens (api + frontend)
+        run: docker compose build api frontend
+
+      - name: Subir db + api + frontend
+        run: docker compose up -d db api frontend
+
+      - name: Aguardar API e validar health
+        run: |
+          set -e
+          for i in $(seq 1 40); do
+            if curl -fsS http://localhost:8000/health >/dev/null 2>&1; then
+              echo "API pronta após ${i} tentativas"
+              break
+            fi
+            sleep 3
+            if [ "$i" -eq 40 ]; then
+              echo "::error::API não respondeu em 120s"
+              docker compose logs api
+              exit 1
+            fi
+          done
+
+          echo "--- API direta ---"
+          curl -fsS http://localhost:8000/health
+
+          echo "--- Frontend (index) ---"
+          curl -fsS -o /dev/null -w "HTTP %{http_code}\n" http://localhost:5173/
+
+          echo "--- Health via proxy do nginx ---"
+          curl -fsS http://localhost:5173/health
+
+      - name: Logs em caso de falha
+        if: failure()
+        run: docker compose logs --no-color
+
+      - name: Derrubar containers
+        if: always()
+        run: docker compose down -v
+
+  # ---------------------------------------------------------------------------
+  # 4) Deploy: SSH na VPS, sincroniza o master e reergue o compose.
+  #    Só roda em push no master e se todos os jobs acima passarem.
+  #    Secrets necessários (Settings → Secrets and variables → Actions):
+  #      VPS_SSH_KEY  → chave privada SSH (a pública vai em ~/.ssh/authorized_keys)
+  #      VPS_HOST     → IP/host da VPS (169.58.113.93)
+  #      VPS_USER     → usuário SSH (ex.: root)
+  #      VPS_APP_DIR  → caminho do repo na VPS (ex.: /root/GranaAI)
+  # ---------------------------------------------------------------------------
+  deploy:
+    name: Deploy · VPS
+    runs-on: ubuntu-latest
+    needs: [backend, frontend, docker]
+    if: github.event_name == 'push' && github.ref == 'refs/heads/master'
+
+    steps:
+      - name: Deploy via SSH
+        uses: appleboy/ssh-action@v1
+        env:
+          DEPLOY_GITHUB_TOKEN: ${{ github.token }}
+          DEPLOY_REPOSITORY_URL: ${{ github.server_url }}/${{ github.repository }}.git
+        with:
+          host: ${{ secrets.VPS_HOST }}
+          username: ${{ secrets.VPS_USER }}
+          key: ${{ secrets.VPS_SSH_KEY }}
+          envs: DEPLOY_GITHUB_TOKEN,DEPLOY_REPOSITORY_URL
+          script: |
+            set -e
+            cd "${{ secrets.VPS_APP_DIR }}"
+            : "${DEPLOY_GITHUB_TOKEN:?Token de leitura ausente no deploy}"
+            : "${DEPLOY_REPOSITORY_URL:?URL do repositorio ausente no deploy}"
+            # Credencial apenas para este fetch; nao persiste token na VPS.
+            GIT_TERMINAL_PROMPT=0 git \
+              -c credential.helper= \
+              -c 'credential.helper=!f() { if [ "$1" = get ]; then printf "%s\n" "username=x-access-token" "password=$DEPLOY_GITHUB_TOKEN"; fi; }; f' \
+              fetch "$DEPLOY_REPOSITORY_URL" +refs/heads/master:refs/remotes/origin/master
+            unset DEPLOY_GITHUB_TOKEN
+            git reset --hard origin/master
+
+            # Serviços com build local. Os demais (db, caddy, evolution-*)
+            # usam imagens prontas e não mudam a cada commit — recriá-los só
+            # derrubaria o banco e a ponte do WhatsApp sem ganho algum.
+            # Descobre a lista sozinho; cai na lista fixa se o Compose local
+            # for antigo demais para `config --format json`.
+            built=$(docker compose config --format json 2>/dev/null \
+              | python3 -c "import json,sys; print(' '.join(k for k,v in json.load(sys.stdin)['services'].items() if v.get('build')))" 2>/dev/null \
+              || echo "")
+            built=${built:-api frontend}
+            echo "Serviços com build local: $built"
+
+            docker compose build $built
+            # --force-recreate garante a troca mesmo se o Compose achar o
+            # container "up-to-date" (imagem com atestação do BuildKit).
+            docker compose up -d --force-recreate --no-deps $built
+
+            # Garante os demais serviços no ar e limpa serviços órfãos.
+            docker compose up -d --remove-orphans
+            docker compose ps
+            docker image prune -f
